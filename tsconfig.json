{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2020",
		"outDir": "out",
		"lib": [
			"es2020",
			"DOM",
			"DOM.Iterable"
		],
    "jsx": "react-jsx",
    "moduleResolution": "node",
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/webview/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	],
  "include": [
    "src/**/*"
  ]
}
